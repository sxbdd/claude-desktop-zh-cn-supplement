@echo off
chcp 936 >nul
cd /d "%~dp0"

echo ============================================================
echo  第 1 步：安装上游汉化包 claude-desktop-zh-cn
echo ============================================================
echo.
echo  接下来会运行上游安装程序，它会：
echo    - 自己弹出 UAC 提权窗口（请点「是」）
echo    - 在新窗口里让你选择安装模式
echo.
echo  ！！模式请选「1」（Windows 模式 1），
echo     完整模式会破坏 Cowork / 沙箱功能。
echo.
pause

call "%~dp0upstream\install-windows.bat"

echo.
echo ============================================================
echo  上游安装程序已在另一个窗口启动。
echo.
echo  请等那个窗口全部跑完、看到安装成功的提示之后，
echo  再双击「第2步-安装补充汉化.bat」。
echo ============================================================
echo.
pause
